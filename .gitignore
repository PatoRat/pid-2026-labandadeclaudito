# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/lib/generated

# skills vendoreadas por `prisma init` — no van al repo
/.windsurf
/.agents
/skills-lock.json
/.claude/skills/prisma-*

# de .claude/ solo se commitea lo compartido del equipo (agents/, skills/
# propias, settings.json), nunca el estado local de cada uno
/.claude/settings.local.json
/.claude/*.local.json

branch_context.md
# docs/ es local: planes técnicos y notas de sprint, no se pushean.
# El backlog real vive en Jira.
/docs
# Serena MCP tool config (local, per-dev)
/.serena

# fotos subidas a mano en este fork (en el repo real van a Vercel Blob)
/public/uploads
